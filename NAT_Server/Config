GCP VPC Provisioning

gcloud compute networks create nat-network \
  --subnet-mode=custom


Subnet Configuration

gcloud compute networks subnets create nat-network-subnet1 \
  --network=nat-network \
  --region=asia-east1-a \
  --range=10.0.1.0/24



Create the GCP VPC

gcloud compute networks create nat-network \
  --subnet-mode=custom


Create the GCP VPC subnets

gcloud compute networks subnets create nat-network-subnet1 \
  --network=nat-network \
  --region=asia-east1-a \
  --range=10.0.1.0/24


Create the GCP VM

gcloud compute instances create nat-gateway \
  --zone=asia-east1-a \
  --machine-type=e2-medium \
  --network-interface=subnet=nat-network-subnet1 \
  --image-family=debian-12 \
  --image-project=debian-cloud \
  --can-ip-forward 


Configure NAT on VM

Once the machine is created ssh to the machine and performed the following configuration. First change the sudo password “sudo passwd root “ then login as root “su -”

sysctl -w net.ipv4.ip_forward=1
echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.conf

# Configure iptables for NAT
iptables -t nat -A POSTROUTING -o ens4 -j MASQUERADE
iptables -A FORWARD -i ens4 -j ACCEPT
iptables -A FORWARD -o ens4 -m state --state RELATED,ESTABLISHED -j ACCEPT

# Install iptables-persistent to survive reboots
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y iptables-persistent
netfilter-persistent save




Create the Firewall rules, Needs to be checked

gcloud compute firewall-rules create allow-internal-to-nat \
  --network=nat-network \
  --allow=tcp,udp,icmp \
  --source-ranges= \
  --target-tags=nat-gateway2




Configure GRE tunnel on Linux (permanent)


nano /etc/netplan/99-gre-tunnel.yaml

network:
  version: 2
  tunnels:
    gre1:
      mode: gre
      ttl: 25
      local: 98.98.98.98
      remote: 99.99.99.99
      addresses:
        - 10.1.2.1/30


sudo netplan apply


Deploy FRR

sudo apt update && sudo apt upgrade -y

echo "net.ipv4.ip_forward = 1" | sudo tee -a /etc/sysctl.conf

echo "net.ipv6.conf.all.forwarding = 1" | sudo tee -a /etc/sysctl.conf

sudo sysctl -p

sudo apt install frr frr-pythontools -y

sudo sed -i 's/bgpd=no/bgpd=yes/g' /etc/frr/daemons

sudo systemctl restart frr

sudo systemctl enable frr


Configure BGP on Linux FRR

sudo vtysh

nat-gateway# config t
nat-gateway(config)#
ip prefix-list ALL seq 5 permit 0.0.0.0/0 le 32
!
route-map ALL permit 10
 match ip address prefix-list ALL
!
router bgp 65009
 bgp router-id 98.98.98.98
 neighbor 10.1.2.2 remote-as 65000
 !
 address-family ipv4 unicast
  neighbor 10.1.2.2 soft-reconfiguration inbound
  neighbor 10.1.2.2 route-map ALL in
  neighbor 10.1.2.2 route-map ALL out
  neighbor 10.1.2.2 default-originate 
 exit-address-family
exit


